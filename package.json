{
  "name": "vue-file-manager",
  "version": "1.0.0-beta.3",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vue-tsc -b && vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@types/js-yaml": "^4.0.9",
    "aplayer": "^1.10.1",
    "artplayer": "^5.4.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "monaco-editor": "^0.55.1",
    "multer": "^1.4.5-lts.1",
    "pinia": "^2.3.1",
    "upyun": "^3.4.5",
    "viewerjs": "^1.11.7",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.19.19",
    "@vitejs/plugin-vue": "^5.2.3",
    "tailwindcss": "^4.0.14",
    "tsx": "^4.19.3",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vue-tsc": "^2.2.0"
  },
  "packageManager": "yarn@4.9.1"
}
